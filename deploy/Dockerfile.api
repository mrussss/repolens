FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/repolens-api cmd/api/main.go

FROM alpine:3.19
RUN apk --no-cache add ca-certificates git
WORKDIR /app
COPY --from=builder /bin/repolens-api /app/repolens-api
EXPOSE 8080
ENTRYPOINT ["/app/repolens-api"]
