# ==============================================================================
# RepoLens Configuration Template
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Application Environment (development / test / production)
ENV=development
HTTP_BIND_ADDR=127.0.0.1
HTTP_PORT=8080

# Database Configuration
# DBDriver: "mysql" for production, "sqlite" for standalone/local testing
DB_DRIVER=mysql
DB_DSN=repolens:repolens_pass@tcp(127.0.0.1:3306)/repolens?charset=utf8mb4&parseTime=True&loc=Local

# Snapshot and Repository Storage
SNAPSHOT_BASE_PATH=/tmp/repolens/repositories
PROVIDER_SECRET_PATH=/tmp/repolens/provider.json

# Local security and repository limits
GIT_ALLOWED_HOSTS=github.com
MAX_CLONE_DISK_BYTES=209715200
MAX_INDEXABLE_SOURCE_BYTES=52428800
MAX_FILE_COUNT=2000
MAX_FILE_SIZE_KB=512

# OpenAI-compatible provider (fake is deterministic demo-only)
REPOLENS_PROVIDER_TYPE=fake
REPOLENS_PROVIDER_API_KEY=
REPOLENS_PROVIDER_BASE_URL=https://api.openai.com/v1
REPOLENS_PROVIDER_MODEL=gpt-4o
REPOLENS_PROVIDER_AUTH_MODE=bearer
# Generation settings are passed to both API and Worker by Docker Compose.
# Changes require recreating both services; existing DiagnosisRuns keep their
# frozen settings. High reasoning support depends on the configured provider.
REPOLENS_REASONING_EFFORT=low
REPOLENS_MAX_OUTPUT_TOKENS=4096
REPOLENS_PROVIDER_TIMEOUT_SECONDS=60
# Experimental matched comparison: low/high with 8192 tokens and 180 seconds.
# The connection probe does not validate a complete multi-round diagnosis.
# Retrieval uses pinned build metadata; the production default is BM25.
