# ==============================================================================
# RepoLens Configuration Template
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Application Environment (development / test / production)
ENV=development
HTTP_PORT=8080

# Database Configuration
# DBDriver: "mysql" for production, "sqlite" for standalone/local testing
DB_DRIVER=mysql
DB_DSN=repolens:repolens_pass@tcp(127.0.0.1:3306)/repolens?charset=utf8mb4&parseTime=True&loc=Local

# Message Broker Configuration (RabbitMQ AMQP 0-9-1)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# Snapshot and Repository Storage
SNAPSHOT_BASE_PATH=/tmp/repolens/repositories

# Authentication & Security
JWT_SECRET=change-this-to-a-secure-random-secret-key-at-least-32-chars
MAX_REPO_SIZE_MB=50
MAX_FILE_COUNT=2000
MAX_FILE_SIZE_KB=512

# Search & Retrieval Engine (Elasticsearch 8.x)
ES_URL=http://127.0.0.1:9200
ES_INDEX_NAME=repolens_chunks

# LLM Diagnostic Agent (Provider: "fake" for testing, "openai" for production)
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Vector Embeddings (Provider: "local" for deterministic token hash, "openai" for neural embeddings)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=128
